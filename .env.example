# Future integrations only. Leave values empty until their own TASK.
# Public catalog and admin authentication (Supabase foundation is not configured in T003).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only order request operations. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Preview-only operational notifications. Keep disabled in Production.
ORDER_NOTIFICATIONS_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server-only public canonical origin. Never use a Preview deployment URL.
SITE_URL=https://example.com

# Future production-only analytics.
YANDEX_METRIKA_ID=
